            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ByteplusStatusResponse" },
                "example": { "data": { "status": "completed", "url_video": "https://storage.botnoi.ai/.../video.mp4" } }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
