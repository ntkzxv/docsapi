    "/api/genai/wavespeed/gpt-image/text-to-image": {
      "post": {
        "tags": ["GPT Image Studio"],
        "summary": "Create GPT Image (Text to Image)",
        "description": "ส่งคำสั่ง Prompt สำหรับสร้างรูปภาพใหม่ด้วยโมเดล GPT Image — ได้รับ task_id สำหรับนำไป polling",
        "operationId": "createGptImageTextToImage",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt":               { "type": "string",  "description": "ข้อความอธิบายรูปภาพที่ต้องการสร้าง" },
                  "resolution":           { "type": "string",  "description": "ความละเอียด", "enum": ["1k", "2k"] },
                  "quality":              { "type": "string",  "description": "คุณภาพ", "enum": ["low", "medium", "high"] },
                  "aspect_ratio":         { "type": "string",  "description": "อัตราส่วนภาพ", "enum": ["1:1", "16:9", "9:16", "4:3"] },
                  "output_format":        { "type": "string",  "description": "รูปแบบไฟล์ผลลัพธ์", "enum": ["png", "jpeg", "webp"] },
                  "enable_sync_mode":     { "type": "boolean", "description": "Sync mode (default: false)", "default": false },
                  "enable_base64_output": { "type": "boolean", "description": "Base64 output (default: false)", "default": false }
                }
              },
              "example": {
                "prompt": "a cute cat in astronaut suit, cinematic lighting",
                "resolution": "1k",
                "quality": "low",
                "aspect_ratio": "1:1",
                "output_format": "png",
                "enable_sync_mode": false,
                "enable_base64_output": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GptImageTaskResponse" },
                "example": { "code": 200, "message": "success", "data": { "id": "pred_20261008xxxxxxxxx", "status": "queued" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    },

    "/api/genai/upload_image": {
      "post": {
        "tags": ["GPT Image Studio"],
        "summary": "Upload image for editing",
        "description": "อัปโหลดไฟล์รูปภาพขึ้น Amazon S3 เพื่อรับ img_url นำไปใช้ใน Image Edit endpoint",
        "operationId": "uploadImage",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "ไฟล์รูปภาพ (.png, .jpg, .webp)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "upload successfully" },
                    "img_url": { "type": "string", "example": "https://botnoiaudio.s3.amazonaws.com/default/production/user_xxx/image_xxx.png" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/api/genai/wavespeed/gpt-image/edit": {
      "post": {
        "tags": ["GPT Image Studio"],
        "summary": "Edit image with prompt",
        "description": "ส่งคำสั่ง Prompt พร้อม URL รูปภาพต้นฉบับ (จาก upload_image) เพื่อให้ AI ทำการแก้ไขหรือตกแต่งภาพ",
        "operationId": "editGptImage",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt", "images"],
                "properties": {
                  "prompt":               { "type": "string",  "description": "คำสั่งแก้ไขภาพ" },
                  "images":               { "type": "array",   "items": { "type": "string" }, "description": "Array ของ URL รูปภาพต้นฉบับ (ได้จาก upload_image)" },
                  "output_format":        { "type": "string",  "description": "รูปแบบไฟล์ผลลัพธ์", "enum": ["png", "jpeg", "webp"] },
                  "enable_sync_mode":     { "type": "boolean", "default": false },
                  "enable_base64_output": { "type": "boolean", "default": false }
                }
              },
              "example": {
                "prompt": "change background to snowy mountain",
                "images": ["https://botnoiaudio.s3.amazonaws.com/default/production/user_xxx/image_xxx.png"],
                "output_format": "png",
                "enable_sync_mode": false,
                "enable_base64_output": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GptImageTaskResponse" },
                "example": { "code": 200, "message": "success", "data": { "id": "pred_20261008xxxxxxxxx", "status": "queued" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    }
  },

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "ใส่ Botnoi token: Authorization: Bearer <_bn_token>"
      }
    },
    "schemas": {
      "TaskResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id":      { "type": "string", "description": "Task ID" },
              "task_id": { "type": "string", "description": "Task ID (บาง endpoint ใช้ field นี้)" },
              "status":  { "type": "string", "example": "pending" }
            }
          }
        }
      },
      "WavespeedResultResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id":        { "type": "string" },
              "status":    { "type": "string", "enum": ["pending", "processing", "completed", "success", "failed"] },
              "url_video": { "type": "string", "description": "URL วิดีโอ/รูปภาพผลลัพธ์ (เมื่อ status = completed/success)" },
              "error":     { "type": "string" }
            }
          }
        }
      },
      "ByteplusStatusResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status":    { "type": "string", "enum": ["processing", "completed", "done", "success", "failed"] },
              "url_video": { "type": "string", "description": "URL ผลลัพธ์" },
              "resp_data": { "type": "string", "description": "JSON string ผลลัพธ์ (บาง endpoint)" }
            }
          }
        }
      },
      "GptImageTaskResponse": {
        "type": "object",
        "properties": {
          "code":    { "type": "integer", "example": 200 },
          "message": { "type": "string",  "example": "success" },
          "data": {
            "type": "object",
            "properties": {
              "id":     { "type": "string", "description": "Task ID สำหรับ polling" },
              "status": { "type": "string", "example": "queued" }
            }
          }
        }
      },
      "GptImageStatusResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "task_id":   { "type": "string" },
              "progress":  { "type": "integer", "minimum": 0, "maximum": 100 },
              "status":    { "type": "string", "enum": ["processing", "completed", "failed"] },
              "video_url": { "type": "string", "description": "URL รูปภาพผลลัพธ์ (เมื่อ status = completed)" }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "error":   { "type": "string" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized — token ไม่ถูกต้องหรือหมดอายุ",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InsufficientCredits": {
        "description": "Forbidden — credits ไม่เพียงพอ",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Task not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
