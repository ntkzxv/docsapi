{
  "openapi": "3.0.3",
  "info": {
    "title": "Botnoi AI Gateway API",
    "description": "ระบบ API กลางของ Botnoi สำหรับสร้างวิดีโอ อวาตาร์พูด รูปภาพ และ GPT Image ด้วย AI",
    "version": "1.0.0",
    "contact": {
      "name": "Botnoi Group",
      "url": "https://botnoi.ai"
    }
  },
  "servers": [
    {
      "url": "https://api-voice.botnoi.ai",
      "description": "Production"
    }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "tags": [
    { "name": "Video Generation",   "description": "สร้างวิดีโอด้วย SeeDance 2.0 / 2.5" },
    { "name": "Avatar Video",       "description": "อวาตาร์พูดซิงค์เสียง (OmniHuman, InfiniteTalk, Motion Control, DreamActor)" },
    { "name": "Image Generation",   "description": "สร้างรูปภาพด้วย SeeDream 4.5" },
    { "name": "GPT Image Studio",   "description": "Text to Image, Image Edit และ Check Status ด้วย GPT Image Model" }
  ],
  "paths": {

    "/api/genai/wavespeed/bytedance/seedance-2.5/text-to-video": {
      "post": {
        "tags": ["Video Generation"],
        "summary": "Create Seedance 2.5 video",
        "description": "โมเดลสร้างวิดีโอคุณภาพสูง (Flagship) รองรับ Text-to-Video, Image-to-Video (First & Last frame) และ Reference Media",
        "operationId": "createSeedance25Video",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt", "duration", "resolution"],
                "properties": {
                  "prompt":           { "type": "string",  "description": "ข้อความอธิบายวิดีโอที่ต้องการ" },
                  "duration":         { "type": "number",  "description": "ความยาว เช่น 5 หรือ 10 วินาที", "example": 5 },
                  "resolution":       { "type": "string",  "description": "ความละเอียด", "enum": ["720p", "1080p"] },
                  "aspect_ratio":     { "type": "string",  "description": "อัตราส่วนภาพ", "enum": ["16:9", "9:16"] },
                  "generate_audio":   { "type": "boolean", "description": "สร้างเสียงประกอบวิดีโอ" },
                  "reference_images": { "type": "array",   "items": { "type": "string" }, "description": "Array ของรูปภาพแบบ Base64 Data URL" },
                  "reference_videos": { "type": "array",   "items": { "type": "string" }, "description": "Array ของวิดีโออ้างอิงแบบ Base64 Data URL" }
                }
              },
              "example": {
                "prompt": "a cinematic sunset over the ocean",
                "duration": 5,
                "resolution": "1080p",
                "aspect_ratio": "16:9",
                "generate_audio": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskResponse" },
                "example": { "data": { "id": "task_seedance25_abc123", "status": "pending" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    },

    "/api/genai/wavespeed/result/{id}": {
      "get": {
        "tags": ["Video Generation"],
        "summary": "Get Seedance 2.5 / GPT Image result",
        "description": "ตรวจสอบสถานะและดึง url_video — ใช้ path เดียวกับ InfiniteTalk, Motion Control และ GPT Image",
        "operationId": "getWavespeedResult",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task ID ที่ได้จาก POST (field: data.id)",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WavespeedResultResponse" },
                "examples": {
                  "processing": {
                    "summary": "ระหว่างประมวลผล",
                    "value": { "data": { "id": "task_abc123", "status": "processing" } }
                  },
                  "completed": {
                    "summary": "เสร็จสมบูรณ์",
                    "value": { "data": { "id": "task_abc123", "status": "completed", "url_video": "https://storage.botnoi.ai/.../output.mp4" } }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },

    "/api/genai/byteplus/video-generation": {
      "post": {
        "tags": ["Video Generation"],
        "summary": "Create SeeDance 2.0 / Mini video",
        "description": "BytePlus Engine — Text-to-Video หรือ Image-to-Video ด้วย dreamina-seedance-2-0 หรือ mini model",
        "operationId": "createSeedance20Video",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["prompt", "mode", "duration", "ratio", "resolution"],
                "properties": {
                  "prompt":     { "type": "string", "description": "ข้อความ Prompt" },
                  "mode":       { "type": "string", "description": "โหมดสร้างวิดีโอ", "enum": ["text-to-video", "image-to-video"] },
                  "model":      { "type": "string", "description": "โมเดล", "enum": ["dreamina-seedance-2-0-260128", "dreamina-seedance-2-0-mini-260615"] },
                  "image_file": { "type": "string", "format": "binary", "description": "ไฟล์รูปภาพตั้งต้น (Image-to-Video)" },
                  "duration":   { "type": "string", "description": "ความยาว", "enum": ["5", "10"] },
                  "ratio":      { "type": "string", "description": "อัตราส่วนภาพ", "enum": ["16:9", "9:16"] },
                  "resolution": { "type": "string", "description": "ความละเอียด", "enum": ["720p", "1080p"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskResponse" },
                "example": { "data": { "task_id": "task_seedance20_xyz789" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/InsufficientCredits" }
        }
      }
    },

    "/api/genai/byteplus/video-generation/{task_id}": {
      "get": {
        "tags": ["Video Generation"],
        "summary": "Get SeeDance 2.0 result",
        "description": "ตรวจสอบสถานะ task และดึง url_video ของ SeeDance 2.0 / Mini",
        "operationId": "getSeedance20Result",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
